<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="6dp">
    <LinearLayout android:id="@+id/cinema_b_home_shelf_heading" android:layout_width="match_parent" android:layout_height="48dp" android:paddingStart="16dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground">
        <TextView android:id="@+id/cinema_b_home_shelf_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/inter" android:textColor="@color/darkForeground" android:textSize="16sp" android:textStyle="bold" />
        <ImageView android:id="@+id/cinema_b_home_shelf_more" android:layout_width="40dp" android:layout_height="40dp" android:padding="10dp" android:src="@drawable/cinema_b_home_chevron" app:tint="@color/darkForeground" android:importantForAccessibility="no" />
    </LinearLayout>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/cinema_b_home_shelf_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:clipToPadding="false" android:paddingStart="16dp" android:paddingEnd="8dp" android:overScrollMode="never" />
</LinearLayout>
