<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="52dp"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginTop="2dp"
    android:layout_marginBottom="2dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:gravity="center_vertical"
    android:clickable="true"
    android:focusable="true"
    android:background="@drawable/bg_selected_nav_item"
    android:foreground="?attr/selectableItemBackground">
    <io.lbry.browser.ui.controls.SolidIconView
        android:id="@+id/nav_menu_item_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:gravity="center"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:textColor="@drawable/fg_nav_menu_item"
        android:textSize="18dp" />
    <TextView
        android:id="@+id/nav_menu_title"
        android:fontFamily="@font/inter"
        android:layout_marginStart="14dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@drawable/fg_nav_menu_item"
        android:textSize="15sp" />
    <ImageView
        android:id="@+id/nav_menu_selected_indicator"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:src="@drawable/ic_check"
        android:importantForAccessibility="no"
        android:visibility="invisible"
        app:tint="@color/cinemaAccent" />
</LinearLayout>
