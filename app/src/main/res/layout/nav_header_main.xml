<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cinema_drawer_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp"
    android:background="@color/drawerBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@mipmap/ic_launcher"
            android:importantForAccessibility="no" />
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:fontFamily="@font/inter"
            android:text="@string/app_name"
            android:textColor="@color/darkForeground"
            android:textSize="18sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/cinema_drawer_close"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="14dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cinema_close_menu"
            android:src="@drawable/ic_close"
            app:tint="@color/lightForeground" />
    </LinearLayout>

    <TextView
        android:id="@+id/cinema_notifications_entry"
        android:layout_width="match_parent" android:layout_height="48dp"
        android:layout_marginTop="8dp" android:paddingStart="12dp" android:paddingEnd="12dp"
        android:gravity="center_vertical" android:fontFamily="@font/inter"
        android:text="@string/notifications" android:textSize="14sp"
        android:textColor="@color/darkForeground" android:drawableStart="@drawable/ic_notifications"
        android:drawableTint="@color/cinemaAccent" android:drawablePadding="12dp"
        android:background="?attr/selectableItemBackground" android:clickable="true" android:focusable="true" />

    <LinearLayout
        android:id="@+id/sign_in_button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:background="@drawable/cinema_panel"
        android:foreground="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true">
        <TextView
            android:id="@+id/sign_in_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/inter"
            android:text="@string/sign_in"
            android:textColor="@color/cinemaAccent"
            android:textSize="15sp"
            android:textStyle="bold" />
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_arrow_right"
            android:importantForAccessibility="no"
            app:tint="@color/cinemaAccent" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/signed_in_email_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:orientation="vertical"
        android:background="@drawable/cinema_panel"
        android:visibility="gone">
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/inter"
            android:text="@string/cinema_your_account"
            android:textColor="@color/lightForeground"
            android:textSize="12sp" />
        <TextView
            android:id="@+id/signed_in_email"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="middle"
            android:fontFamily="@font/inter"
            android:maxLines="1"
            android:textColor="@color/darkForeground"
            android:textSize="14sp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/sign_out_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:fontFamily="@font/inter"
            android:text="@string/sign_out"
            android:textAllCaps="false"
            android:textColor="@color/cinemaAccent" />
    </LinearLayout>

    <View
        android:id="@+id/sign_in_header_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/divider" />
</LinearLayout>
